{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "key-west-shore-excursions-w2",
  "main": "src/index.js",
  "compatibility_date": "2026-09-14",
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
